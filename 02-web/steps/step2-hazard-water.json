[
  {
    "id": "water",
    "type": "fill",
    "source": "evac",
    "source-layer": "water",
    "filter": [
      "==",
      [
        "geometry-type"
      ],
      "Polygon"
    ],
    "paint": {
      "fill-color": "#a6cee3"
    }
  },
  {
    "id": "land_cover",
    "type": "fill",
    "source": "evac",
    "source-layer": "land_cover",
    "paint": {
      "fill-color": "#e5f5e0",
      "fill-opacity": 0.6
    }
  },
  {
    "id": "hazard",
    "type": "fill",
    "source": "evac",
    "source-layer": "hazard",
    "paint": {
      "fill-color": [
        "match",
        [
          "get",
          "FHSZ_Description"
        ],
        "Moderate",
        "#fdbb84",
        "High",
        "#e34a33",
        "Very High",
        "#b30000",
        "#cccccc"
      ],
      "fill-opacity": 0.45
    }
  },
  {
    "id": "shelters",
    "type": "circle",
    "source": "evac",
    "source-layer": "shelters",
    "paint": {
      "circle-radius": 7,
      "circle-color": "#ffffff",
      "circle-opacity": [
        "case",
        [
          "==",
          [
            "get",
            "status"
          ],
          "verified"
        ],
        1,
        0
      ],
      "circle-stroke-color": "#000000",
      "circle-stroke-width": 1.5
    }
  },
  {
    "id": "towns",
    "type": "symbol",
    "source": "evac",
    "source-layer": "towns",
    "minzoom": 6,
    "layout": {
      "text-field": [
        "get",
        "name"
      ],
      "text-font": [
        "case",
        [
          "in",
          [
            "get",
            "class"
          ],
          [
            "literal",
            [
              "city",
              "town"
            ]
          ]
        ],
        [
          "literal",
          [
            "Noto Sans Medium"
          ]
        ],
        [
          "literal",
          [
            "Noto Sans Regular"
          ]
        ]
      ],
      "text-size": [
        "match",
        [
          "get",
          "class"
        ],
        "city",
        16,
        "town",
        14,
        "village",
        12,
        11
      ],
      "text-transform": [
        "match",
        [
          "get",
          "class"
        ],
        "city",
        "uppercase",
        "none"
      ],
      "text-letter-spacing": [
        "match",
        [
          "get",
          "class"
        ],
        "city",
        0.1,
        0
      ],
      "text-anchor": "center",
      "text-padding": 6,
      "symbol-sort-key": [
        "-",
        0,
        [
          "coalesce",
          [
            "get",
            "population"
          ],
          0
        ]
      ]
    },
    "paint": {
      "text-color": "#263238",
      "text-halo-color": "#ffffffee",
      "text-halo-width": 1.6
    }
  }
]
