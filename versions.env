# Routes to Safety — the one config file. Every script, the Dockerfile, docker-compose.yml and check_setup.py read it.
# Change a value here, nowhere else (scripts/check-versions.sh fails CI if another file repeats a stale value).

# --- study area (Phase 4: change these four lines, then run the Phase 4 steps) ---
# Placer County I-80 corridor, Rocklin → Auburn → Colfax → Foresthill (+ the Mosquito Fire 2022 footprint). W, S, E, N in degrees.
BBOX_W=-121.40
BBOX_S=38.72
BBOX_E=-120.52
BBOX_N=39.20
# 3D buildings are heavy, so they are fetched for one town only (Auburn). For a small box use the same four values as BBOX_*.
BUILDINGS_W=-121.12
BUILDINGS_S=38.88
BUILDINGS_E=-121.03
BUILDINGS_N=38.96
# OpenStreetMap extract that contains the box — any region file from https://download.geofabrik.de (the routing graph is cut from it)
OSM_EXTRACT_URL=https://download.geofabrik.de/north-america/us/california/norcal-latest.osm.pbf
# Hazard (California only — CAL FIRE). Which past fire perimeters to keep; outside California run scripts/fetch-hazard.sh --none
FIRE_PERIMETERS_WHERE="(FIRE_NAME='MOSQUITO' AND YEAR_=2022) OR (FIRE_NAME='RIVER' AND YEAR_=2021)"
CALFIRE_FHSZ_URL=https://services1.arcgis.com/jUJYIo9tSA7EHvfZ/arcgis/rest/services/fhsz24_1/FeatureServer/0
CALFIRE_PERIMETERS_URL=https://services1.arcgis.com/jUJYIo9tSA7EHvfZ/arcgis/rest/services/California_Historic_Fire_Perimeters/FeatureServer/0

# --- data release ---
OVERTURE_RELEASE=2026-09-23.1
OVERTURE_S3=s3://overturemaps-us-west-2/release

# --- tools ---
DUCKDB_VERSION=2.0.0
JAVA_VERSION=21
PLANETILER_VERSION=0.10.2
PMTILES_VERSION=1.31.2
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian
CADDY_IMAGE=caddy:2-alpine
NODE_VERSION=22
MAPLIBRE_VERSION=6.14.0
PMTILES_JS_VERSION=4.5.0
MARP_VERSION=4.5.1
OSMIUM_VERSION=1.19
