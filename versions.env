# Routes to Safety — single source of truth for every pin.
# Read by: Dockerfile, docker-compose.yml, scripts/*.sh, setup/check_setup.py, README (via scripts/check-versions.sh).
# Change a value here, nowhere else.

# --- data ---
OVERTURE_RELEASE=2026-09-23.1
OVERTURE_S3=s3://overturemaps-us-west-2/release
# Study area: Placer County I-80 corridor, Rocklin → Auburn → Colfax → Foresthill (+ Mosquito Fire 2022 footprint)
BBOX_W=-121.40
BBOX_S=38.72
BBOX_E=-120.52
BBOX_N=39.20
# Auburn subset for the buildings layer (z13+ only)
AUBURN_W=-121.12
AUBURN_S=38.88
AUBURN_E=-121.03
AUBURN_N=38.96
# Colfax clip for the build-your-own-OSRM-graph stretch (Phase 2b, optional)
COLFAX_W=-121.02
COLFAX_S=39.05
COLFAX_E=-120.90
COLFAX_N=39.13
OSM_EXTRACT_URL=https://download.geofabrik.de/north-america/us/california/norcal-latest.osm.pbf
CALFIRE_FHSZ_URL=https://services1.arcgis.com/jUJYIo9tSA7EHvfZ/arcgis/rest/services/fhsz24_1/FeatureServer/0
CALFIRE_PERIMETERS_URL=https://services1.arcgis.com/jUJYIo9tSA7EHvfZ/arcgis/rest/services/California_Historic_Fire_Perimeters/FeatureServer/0

# --- tools ---
DUCKDB_VERSION=2.0.0
JAVA_VERSION=21
PLANETILER_VERSION=0.10.2
PMTILES_VERSION=1.31.2
OSRM_IMAGE=ghcr.io/project-osrm/osrm-backend:v26.10.0-debian
CADDY_IMAGE=caddy:2-alpine
NODE_VERSION=22
MAPLIBRE_VERSION=6.14.0
PMTILES_JS_VERSION=4.5.0
MARP_VERSION=4.5.1
OSMIUM_VERSION=1.19
